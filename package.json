{
  "name": "ollama-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only AI app and game maker powered by Ollama.",
  "author": "DowntownDiddlerrr <mscofield1588@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "server": "node server/index.mjs",
    "mock": "node mock/ollama-server.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cap:sync": "npm run build && cap sync android",
    "export-apk": "node scripts/export-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
